{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "cppdbg",
            "request": "launch",
            "name": "Meson Run",
            "program": "/bin/bash",
            "args": [
                "-c",
                "meson compile -C build && ninja -C build && ./build/src/still-terminal"
